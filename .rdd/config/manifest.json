{

  "framework": {
    "name": "RDD Framework",
    "version": "1.2.0",
    "semver": true,
    "description": "Requirements-Driven Development framework installed into a repository; framework assets live under .rdd and repo-specific state and documentation live under .rdd-instance.",
    "supportedPlatforms": ["windows", "linux"],
    "runtime": {
      "language": "python",
      "pythonCommand": "python"
    }
  },

  "canonicalRoots": {
    "frameworkRoot": ".rdd",
    "instanceRoot": ".rdd-instance"
  },

  "components": [
    {
      "id": "framework",
      "root": ".rdd",
      "description": "Framework static assets: conventions, docs, prompts, scripts, config.",
      "required": true
    },
    {
      "id": "instance",
      "root": ".rdd-instance",
      "description": "Repo-specific configuration, requirements, specifications, workdir, archive.",
      "required": true
    }
  ],

  "requiredPaths": {
    "framework": [
      ".rdd/config/",
      ".rdd/conventions/",
      ".rdd/docs/",
      ".rdd/prompt-snippets/",
      ".rdd/scripts/"
    ],
    "instance": [
      ".rdd-instance/",
      ".rdd-instance/specifications/",
      ".rdd-instance/workdir/",
      ".rdd-instance/archive/"
    ]
  },

  "requiredFiles": [
    {
      "path": ".rdd-instance/workdir/work-iteration-registry.json",
      "role": "workIterationRegistry",
      "required": true
    },
    {
      "path": ".rdd-instance/workdir/prompts-registry.md",
      "role": "promptsRegistry",
      "required": true
    },    
    {
      "path": ".rdd-instance/specifications/requirements.md",
      "role": "requirements",
      "required": true
    },
    {
      "path": ".rdd/config/technical-design-form.json",
      "role": "technicalDesignFormDefinition",
      "required": true
    }
  ],

  "upgradePolicy": {
    "default": "preserve",
    "rules": [
      { "path": ".rdd/**", "action": "overwrite" },
      { "path": ".rdd-instance/**", "action": "preserve" }
    ]
  }
}
