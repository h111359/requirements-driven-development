  "chat.promptFilesRecommendations": {
    "rdd.execute": true
  },
  "chat.tools.terminal.autoApprove": {
    "/^python\\b.*\\.rdd\\/src\\//": {
      "approve": true,
      "matchCommandLine": true
    }
  },
  "files.associations": {
    "*.jsonl": "jsonlines"
  },
